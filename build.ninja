# CPS — build.ninja (auto-detects amd64/arm64)
# Usage: ninja
#        DESTDIR=/mnt ninja install

rule cargo
  command = sh -c 'case $$(uname -m) in x86_64) T=x86_64-unknown-linux-musl;; aarch64) T=aarch64-unknown-linux-musl;; *) echo "unsupported: $$(uname -m)" >&2; exit 1;; esac; CARGO_TARGET_DIR=$$(pwd)/builddir/cargo cargo build --target $$T --release --locked --bin cps --manifest-path $$(pwd)/Cargo.toml && cp $$(pwd)/builddir/cargo/$$T/release/cps "$out"'
  description = cargo build cps

rule install
  command = install -Dm755 $in $${DESTDIR}/system/bin/cps
  description = install cps

builddir = builddir

build $builddir/cps: cargo
default $builddir/cps

build install: install $builddir/cps
